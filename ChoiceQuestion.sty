% ---------- 引擎主体 ----------
\cs_new_protected:Npn \__CQ_choices:nnn #1 #2 #3
{
  \begingroup                            % 键值作用域局部化
  \int_set:Nn \l__CQ_choices_count_int {#1}
  \keys_set:nn { CQ_keys_choices } {#2}

  % 逐题 color 覆盖宏包级 answer_color（仅在给了 color 键时）
  \tl_if_empty:NF \l_CQ_choices_color_tl
    { \tl_set_eq:NN \l_CQ_answer_color_tl \l_CQ_choices_color_tl }

  \bool_if:NTF \l_CQ_choices_ispicture_bool
    { \tl_set:Nn \l_CQ_choices_label_pos_tl { bottom } }
    { \tl_set:Nn \l_CQ_choices_label_pos_tl { top-left } }

  \clist_set:Nn \l_CQ_choices_items_clist {#3}
  \prop_clear:N \l_CQ_choices_mark_prop

  % ---- 图片选项尺寸调整（全局 + 单项覆盖），结果存入逐项 tl ----
  \clist_set_eq:NN \l__CQ_choices_items_local_clist \l_CQ_choices_items_clist
  \int_step_inline:nn {#1}
    {
      \clist_pop:NN \l__CQ_choices_items_local_clist \l__CQ_pic_item_tl
      \bool_if:NT \l_CQ_choices_ispicture_bool
        {
          \tl_set:Nx \l__CQ_pic_letter_tl { \int_to_Alph:n {##1} }
          \__CQ_pic_prepare_item:NV \l__CQ_pic_item_tl \l__CQ_pic_letter_tl
        }
      \tl_set_eq:cN { l__CQ_choices_item_##1_tl } \l__CQ_pic_item_tl
    }

  % 标记正确答案（answer=C 或多选 answer=BE 均可）
  \bool_if:NT \l_CQ_isanswershown_bool
    {
      \tl_map_inline:Nn \l_CQ_choices_answer_tl
        {
          \str_case:nn {##1}
            {
              { A } { \__CQ_choices_mark:n { 1 } }
              { B } { \__CQ_choices_mark:n { 2 } }
              { C } { \__CQ_choices_mark:n { 3 } }
              { D } { \__CQ_choices_mark:n { 4 } }
              { E } { \__CQ_choices_mark:n { 5 } }
              { F } { \__CQ_choices_mark:n { 6 } }
              { G } { \__CQ_choices_mark:n { 7 } }
              { H } { \__CQ_choices_mark:n { 8 } }
              { I } { \__CQ_choices_mark:n { 9 } }
            }
        }
    }

  % 计算 max-columns（0 = 不传该键）
  \int_set:Nn \l__CQ_choices_maxcols_int { \__CQ_maxcols:n {#1} }
  \tl_clear:N \l__CQ_choices_maxcols_tl
  \int_compare:nNnT { \l__CQ_choices_maxcols_int } > { 0 }
    {
      \tl_set:Nn \l__CQ_choices_maxcols_tl
        { max-columns = \int_use:N \l__CQ_choices_maxcols_int , }
    }

  % 组装键值
  \tl_set:Nx \l__CQ_choices_keys_tl
    {
      \l__CQ_choices_maxcols_tl
      label-pos = \l_CQ_choices_label_pos_tl ,
      top-sep = 3pt ,
      linesep = { 0.5ex plus 0.5ex minus 0.2ex } ,
      label = { \exp_not:N \color { TextDark } \exp_not:N \Alph*. }
    }

  % 组装选项体（统一引用逐项 tl）
  \tl_clear:N \l__CQ_choices_body_tl
  \int_step_inline:nn {#1}
    {
      \tl_put_right:Nn \l__CQ_choices_body_tl { \item }
      \prop_if_in:NnTF \l_CQ_choices_mark_prop {##1}
        {
          \prop_get:NnN \l_CQ_choices_mark_prop {##1} \l_tmpa_tl
          \tl_put_right:NV \l__CQ_choices_body_tl \l_tmpa_tl
        }
        {
          \tl_put_right:Nn \l__CQ_choices_body_tl
            { \tl_use:c { l__CQ_choices_item_##1_tl } }
        }
    }
  \exp_args:NVV \__CQ_choices_typeset:nn
    \l__CQ_choices_keys_tl \l__CQ_choices_body_tl
  \endgroup
}

