% ==========================================================
% 图片尺寸公共基础设施（选择题 / 多图命令共用）
% ==========================================================

% 为模块 #1 定义尺寸键：height/h、width/w、keepaspectratio、hA..hI、wA..wI
\cs_new_protected:Npn \__CQ_pic_define_size_keys_aux:nn #1 #2
  {
    \keys_define:nn { #1 }
      {
        h#2 .code:n = { \dim_set:cn { l__CQ_pic_h_#2_dim } { ##1 } } ,
        w#2 .code:n = { \dim_set:cn { l__CQ_pic_w_#2_dim } { ##1 } } ,
      }
  }

\cs_new_protected:Npn \__CQ_pic_define_size_keys:n #1
  {
    \keys_define:nn { #1 }
      {
        height .dim_set:N = \l__CQ_pic_h_all_dim ,
        h      .dim_set:N = \l__CQ_pic_h_all_dim ,
        width  .dim_set:N = \l__CQ_pic_w_all_dim ,
        w      .dim_set:N = \l__CQ_pic_w_all_dim ,
        keepaspectratio .bool_set:N = \l__CQ_pic_keepar_bool ,
        keepaspectratio .default:n  = true ,
        keepaspectratio .initial:n  = true ,
      }
    \clist_map_inline:nn { A , B , C , D , E , F , G , H , I }
      { \__CQ_pic_define_size_keys_aux:nn { #1 } { ##1 } }
  }

% 计算 #1（字母）对应图片的 includegraphics 选项串 → \l__CQ_pic_opts_tl
% 规则：单项设置（hA/wA…）优先；否则用全局（h/w）；均为 0pt 表示未设置
\cs_new_protected:Npn \__CQ_pic_build_opts:n #1
  {
    \dim_set:Nn \l__CQ_pic_eff_h_dim { \dim_use:c { l__CQ_pic_h_#1_dim } }
    \dim_compare:nNnF { \l__CQ_pic_eff_h_dim } > { 0pt }
      { \dim_set:Nn \l__CQ_pic_eff_h_dim { \l__CQ_pic_h_all_dim } }
    \dim_set:Nn \l__CQ_pic_eff_w_dim { \dim_use:c { l__CQ_pic_w_#1_dim } }
    \dim_compare:nNnF { \l__CQ_pic_eff_w_dim } > { 0pt }
      { \dim_set:Nn \l__CQ_pic_eff_w_dim { \l__CQ_pic_w_all_dim } }
    \tl_clear:N \l__CQ_pic_opts_tl
    \dim_compare:nNnT { \l__CQ_pic_eff_h_dim } > { 0pt }
      { \tl_put_right:Nx \l__CQ_pic_opts_tl
          { height = \dim_use:N \l__CQ_pic_eff_h_dim , } }
    \dim_compare:nNnT { \l__CQ_pic_eff_w_dim } > { 0pt }
      { \tl_put_right:Nx \l__CQ_pic_opts_tl
          { width = \dim_use:N \l__CQ_pic_eff_w_dim , } }
    % 同时设置高与宽时默认等比缩放（仅对 \includegraphics 生效）
    \bool_set:Nn \l__CQ_pic_keepar_now_bool
      {
        \dim_compare_p:nNn { \l__CQ_pic_eff_h_dim } > { 0pt }
        && \dim_compare_p:nNn { \l__CQ_pic_eff_w_dim } > { 0pt }
        && \l__CQ_pic_keepar_bool
      }
    \bool_if:NT \l__CQ_pic_keepar_now_bool
      { \tl_put_right:Nn \l__CQ_pic_opts_tl { keepaspectratio , } }
  }

% 检查 token list 中是否含控制序列（不含 → 视为纯文件名）
\cs_new_protected:Npn \__CQ_pic_check_cs:N #1
  {
    \bool_set_false:N \l__CQ_pic_hascs_bool
    \tl_map_inline:Nn #1
      { \token_if_cs:NT ##1 { \bool_set_true:N \l__CQ_pic_hascs_bool } }
  }

% 识别 \includegraphics 的正则
\regex_new:N \l__CQ_pic_ig_regex
\regex_set:Nn \l__CQ_pic_ig_regex { \c{includegraphics} }
\regex_new:N \l__CQ_pic_igb_regex
\regex_set:Nn \l__CQ_pic_igb_regex { \c{includegraphics} \[ }

% 把选项串注入已有的 \includegraphics（自动处理有/无 [ ] 两种情况）
\cs_new_protected:Npn \__CQ_pic_inject_opts:N #1
  {
    \tl_if_empty:NF \l__CQ_pic_opts_tl
      {
        \regex_match:NVTF \l__CQ_pic_igb_regex #1
          { % 已有可选参数：注入到 [ 之后
            \regex_replace_once:nnN
              { \c{includegraphics} \[ }
              { \c{includegraphics} [ \u { l__CQ_pic_opts_tl } , }
              #1
          }
          { % 无可选参数：补上 [选项]
            \regex_replace_once:nnN
              { \c{includegraphics} }
              { \c{includegraphics} [ \u { l__CQ_pic_opts_tl } ] }
              #1
          }
      }
  }

% 一般内容（\rule、tikz、\tfig 等）用 \resizebox 缩放
% 调用前提：至少一个尺寸 > 0pt
\cs_new_protected:Npn \__CQ_pic_resizebox:N #1
  {
    \dim_compare:nNnTF { \l__CQ_pic_eff_w_dim } > { 0pt }
      {
        \dim_compare:nNnTF { \l__CQ_pic_eff_h_dim } > { 0pt }
          {
            \tl_set:Nx #1
              { \exp_not:N \resizebox { \dim_use:N \l__CQ_pic_eff_w_dim }
                { \dim_use:N \l__CQ_pic_eff_h_dim } { \exp_not:V #1 } }
          }
          {
            \tl_set:Nx #1
              { \exp_not:N \resizebox { \dim_use:N \l__CQ_pic_eff_w_dim }
                { ! } { \exp_not:V #1 } }
          }
      }
      {
        \tl_set:Nx #1
          { \exp_not:N \resizebox { ! }
            { \dim_use:N \l__CQ_pic_eff_h_dim } { \exp_not:V #1 } }
      }
  }

% 统一的图片项预处理：#1 = 项 tl 变量，#2 = 字母
%   纯文件名 → 包裹 \includegraphics[opts]{文件}
%   含 \includegraphics → 注入选项
%   其它内容（有控制序列）→ 有尺寸键时 \resizebox 缩放，否则原样
\cs_new_protected:Npn \__CQ_pic_prepare_item:Nn #1 #2
  {
    \__CQ_pic_build_opts:n {#2}
    \__CQ_pic_check_cs:N #1
    \bool_if:NTF \l__CQ_pic_hascs_bool
      {
        \regex_match:NVTF \l__CQ_pic_ig_regex #1
          { \__CQ_pic_inject_opts:N #1 }
          {
            \tl_if_empty:NF \l__CQ_pic_opts_tl
              { \__CQ_pic_resizebox:N #1 }
          }
      }
      {
        \tl_set:Nx #1
          { \exp_not:N \includegraphics [ \l__CQ_pic_opts_tl ]
            { \exp_not:V #1 } }
      }
  }
\cs_generate_variant:Nn \__CQ_pic_prepare_item:Nn { NV }

