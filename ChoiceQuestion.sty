% ---------- 布局的行记录 ----------
\cs_new_protected:Npn \__CQ_pic_add_row_range:nn #1 #2
  % 第 #1..#2 张图为一行（连续编号，参数为整型表达式文本）
  {
    \tl_clear:N \l__CQ_pic_rowtxt_tl
    \int_step_inline:nn { (#2) - (#1) + 1 }
      {
        \tl_if_empty:NF \l__CQ_pic_rowtxt_tl
          { \tl_put_right:Nn \l__CQ_pic_rowtxt_tl { , } }
        \tl_put_right:Nx \l__CQ_pic_rowtxt_tl
          { \int_eval:n { (#1) + ##1 - 1 } }
      }
    \seq_put_right:NV \l__CQ_pic_layout_seq \l__CQ_pic_rowtxt_tl
  }

\cs_new_protected:Npn \__CQ_pic_add_row_pair:nn #1 #2
  { \seq_put_right:Nn \l__CQ_pic_layout_seq { #1 , #2 } }

\cs_new_protected:Npn \__CQ_pic_add_row_single:n #1
  { \seq_put_right:Nn \l__CQ_pic_layout_seq { #1 } }

% ---------- 一行宽度（含间隙）→ \l__CQ_pic_rowwd_dim ----------
\cs_new_protected:Npn \__CQ_pic_rowwd:nn #1 #2
  {
    \dim_zero:N \l__CQ_pic_rowwd_dim
    \int_step_inline:nn { (#2) - (#1) + 1 }
      {
        \dim_add:Nn \l__CQ_pic_rowwd_dim
          { \dim_use:c { l__CQ_pic_wd_ \int_eval:n { (#1) + ##1 - 1 } _dim } }
      }
    \int_set:Nn \l__CQ_pic_cnt_int { (#2) - (#1) }
    \int_compare:nNnT { \l__CQ_pic_cnt_int } > { 0 }
      {
        \dim_add:Nn \l__CQ_pic_rowwd_dim
          { \int_use:N \l__CQ_pic_cnt_int \l__CQ_pic_gap_dim }
      }
  }

% ---------- 任意两张图同行宽度（含 1 个间隙）→ \l__CQ_pic_rowwd_dim ----------
% 注意：两张图的下标未必连续（如 1、3），不能用 \__CQ_pic_rowwd:nn 的区间版本。
\cs_new_protected:Npn \__CQ_pic_pairwd:nn #1 #2
  {
    \dim_set:Nn \l__CQ_pic_rowwd_dim
      {
        \dim_use:c { l__CQ_pic_wd_#1_dim }
        + \dim_use:c { l__CQ_pic_wd_#2_dim }
        + \l__CQ_pic_gap_dim
      }
  }

% ---------- 每行 #1 列、共 #2 张图是否都放得下 ----------
\prg_new_protected_conditional:Nnn \__CQ_pic_cfits:nn { TF }
  {
    \bool_set_true:N \l__CQ_pic_cfit_bool
    \int_step_inline:nn { \int_div_truncate:nn { #2 + #1 - 1 } { #1 } }
      {
        \__CQ_pic_rowwd:nn
          { ( ##1 - 1 ) * #1 + 1 }
          { \int_min:nn { ##1 * #1 } { #2 } }
        \dim_compare:nNnT { \l__CQ_pic_rowwd_dim } > { \l__CQ_pic_avail_dim }
          { \bool_set_false:N \l__CQ_pic_cfit_bool }
      }
    \bool_if:NTF \l__CQ_pic_cfit_bool
      { \prg_return_true: } { \prg_return_false: }
  }

% ---------- #1 列排 #2 张图时的“最长行宽度” → \l__CQ_pic_maxrow_dim ----------
\cs_new_protected:Npn \__CQ_pic_maxrowwd:nn #1 #2
  {
    \dim_zero:N \l__CQ_pic_maxrow_dim
    \int_step_inline:nn { \int_div_truncate:nn { #2 + #1 - 1 } { #1 } }
      {
        \__CQ_pic_rowwd:nn
          { ( ##1 - 1 ) * #1 + 1 }
          { \int_min:nn { ##1 * #1 } { #2 } }
        \dim_compare:nNnT
          { \l__CQ_pic_rowwd_dim } > { \l__CQ_pic_maxrow_dim }
          { \dim_set_eq:NN \l__CQ_pic_maxrow_dim \l__CQ_pic_rowwd_dim }
      }
  }

% ---------- 一般算法（N ≠ 3） ----------
% 枚举所有可行的列数 c（1..N），先取“行数最少”，行数相同再取“最长行最短”
% （即各行宽度更均衡）。这样 4 张会倾向 2+2、5 张 3+2、6 张 3+3、8 张 4+4，
% 而不是“尽量挤满一行”留下一个孤零零的尾行。
\cs_new_protected:Npn \__CQ_pic_decide_plain:n #1
  {
    \int_zero:N \l__CQ_pic_best_int                    % 0 = 尚无可行列数
    \int_set:Nn \l__CQ_pic_bestrows_int { #1 + 1 }
    \dim_set_eq:NN \l__CQ_pic_best_dim \c_max_dim
    \int_step_inline:nn {#1}   % ##1 = 列数 c
      {
        \__CQ_pic_cfits:nnTF {##1} {#1}
          {
            \__CQ_pic_maxrowwd:nn {##1} {#1}
            \int_set:Nn \l__CQ_pic_cnt_int
              { \int_div_truncate:nn { #1 + ##1 - 1 } { ##1 } }   % 行数
            \bool_if:nT
              {
                \int_compare_p:n
                  { \l__CQ_pic_cnt_int < \l__CQ_pic_bestrows_int }
                || ( \int_compare_p:n
                       { \l__CQ_pic_cnt_int == \l__CQ_pic_bestrows_int }
                     && \dim_compare_p:nNn
                          { \l__CQ_pic_maxrow_dim } < { \l__CQ_pic_best_dim } )
              }
              {
                \int_set_eq:NN \l__CQ_pic_bestrows_int \l__CQ_pic_cnt_int
                \dim_set_eq:NN \l__CQ_pic_best_dim \l__CQ_pic_maxrow_dim
                \int_set:Nn \l__CQ_pic_best_int {##1}
              }
          }
          { }
      }
    \int_compare:nNnTF { \l__CQ_pic_best_int } > { 0 }
      {
        \int_step_inline:nn { \l__CQ_pic_bestrows_int }
          {
            \__CQ_pic_add_row_range:nn
              { ( ##1 - 1 ) * \l__CQ_pic_best_int + 1 }
              { \int_min:nn { ##1 * \l__CQ_pic_best_int } { #1 } }
          }
      }
      { % 兜底：每行一张
        \int_step_inline:nn {#1} { \__CQ_pic_add_row_range:nn {##1} {##1} }
      }
  }

% ---------- 三图专用算法 ----------
% 在所有放得下的"两图同行 + 一图单独"方案里，取两行宽度更均衡者：
% 即最小化 max(两图行宽, 单图宽)。这样很宽的一张会自然单独成行，
% 较窄的两张并排；较宽的一行排在上面。
\cs_new_protected:Npn \__CQ_pic_try_pair:nnn #1 #2 #3
  {
    \__CQ_pic_pairwd:nn {#1} {#2}
    \dim_compare:nNnTF { \l__CQ_pic_rowwd_dim } > { \l__CQ_pic_avail_dim }
      { }                                     % 两图行放不下
      {
        \dim_set:Nn \l__CQ_pic_singlewd_dim
          { \dim_use:c { l__CQ_pic_wd_#3_dim } }
        \dim_compare:nNnTF { \l__CQ_pic_singlewd_dim } > { \l__CQ_pic_avail_dim }
          { }                                 % 单图也放不下
          {
            \dim_set_eq:NN \l__CQ_pic_maxwd_dim \l__CQ_pic_rowwd_dim
            \dim_compare:nNnT
              { \l__CQ_pic_singlewd_dim } > { \l__CQ_pic_maxwd_dim }
              { \dim_set_eq:NN \l__CQ_pic_maxwd_dim \l__CQ_pic_singlewd_dim }
            \dim_compare:nNnT
              { \l__CQ_pic_maxwd_dim } < { \l__CQ_pic_best_dim }
              {
                \dim_set_eq:NN \l__CQ_pic_best_dim \l__CQ_pic_maxwd_dim
                \int_set:Nn \l__CQ_pic_best_int { #1 * 10 + #2 }
                \bool_set_true:N \l__CQ_pic_paired_bool
              }
          }
      }
  }

\cs_new_protected:Npn \__CQ_pic_lay_two_one:nnn #1 #2 #3
  {
    \__CQ_pic_pairwd:nn {#1} {#2}
    \dim_compare:nNnTF { \l__CQ_pic_rowwd_dim } <
      { \dim_use:c { l__CQ_pic_wd_#3_dim } }
      {
        \__CQ_pic_add_row_single:n {#3}       % 单图更宽：一图在上
        \__CQ_pic_add_row_pair:nn  {#1} {#2}
      }
      {
        \__CQ_pic_add_row_pair:nn  {#1} {#2}  % 二图在上
        \__CQ_pic_add_row_single:n {#3}
      }
  }

\cs_new_protected:Npn \__CQ_pic_decide_three:
  {
    \__CQ_pic_rowwd:nn { 1 } { 3 }
    \dim_compare:nNnTF { \l__CQ_pic_rowwd_dim } > { \l__CQ_pic_avail_dim }
      { % 一行放不下：尝试两图组合
        \bool_set_false:N \l__CQ_pic_paired_bool
        \dim_set_eq:NN \l__CQ_pic_best_dim \c_max_dim
        \__CQ_pic_try_pair:nnn { 1 } { 2 } { 3 }
        \__CQ_pic_try_pair:nnn { 1 } { 3 } { 2 }
        \__CQ_pic_try_pair:nnn { 2 } { 3 } { 1 }
        \bool_if:NTF \l__CQ_pic_paired_bool
          {
            \int_case:nn { \l__CQ_pic_best_int }
              {
                { 12 } { \__CQ_pic_lay_two_one:nnn { 1 } { 2 } { 3 } }
                { 13 } { \__CQ_pic_lay_two_one:nnn { 1 } { 3 } { 2 } }
                { 23 } { \__CQ_pic_lay_two_one:nnn { 2 } { 3 } { 1 } }
              }
          }
          { % 三张都过宽：每行一张
            \__CQ_pic_add_row_range:nn { 1 } { 1 }
            \__CQ_pic_add_row_range:nn { 2 } { 2 }
            \__CQ_pic_add_row_range:nn { 3 } { 3 }
          }
      }
      { \__CQ_pic_add_row_range:nn { 1 } { 3 } }   % 一行三张
  }

\cs_new_protected:Npn \__CQ_pic_decide:n #1
  {
    \seq_clear:N \l__CQ_pic_layout_seq
    \int_compare:nNnTF {#1} = { 3 }
      { \__CQ_pic_decide_three: }
      { \__CQ_pic_decide_plain:n {#1} }
  }

% ---------- 排版 ----------
\cs_new_protected:Npn \__CQ_pic_typeset_row:n #1
  {
    \clist_set:Nn \l__CQ_pic_rowidx_clist {#1}
    \bool_set_true:N \l__CQ_pic_firstpic_bool
    \clist_map_inline:Nn \l__CQ_pic_rowidx_clist
      {
        \bool_if:NF \l__CQ_pic_firstpic_bool
          { \skip_horizontal:n { \l__CQ_pic_gap_dim } }
        \bool_set_false:N \l__CQ_pic_firstpic_bool
        \box_use:c { l__CQ_pic_box_##1_box }
      }
  }

% 把一行内容按 \l__CQ_pic_align_tl 在整行宽度内左/中/右对齐
\cs_new_protected:Npn \__CQ_pic_align_row:n #1
  {
    \exp_args:NV \str_case:nnF \l__CQ_pic_align_tl
      {
        { left   } { \__CQ_pic_typeset_row:n {#1} }
        { right  } { \hss \__CQ_pic_typeset_row:n {#1} }
        { center } { \hss \__CQ_pic_typeset_row:n {#1} \hss }
      }
      { \hss \__CQ_pic_typeset_row:n {#1} \hss }
  }

\cs_new_protected:Npn \__CQ_pic_typeset:
  {
    \vbox_set:Nn \l__CQ_pic_all_box
      {
        \offinterlineskip
        \bool_set_true:N \l__CQ_pic_firstrow_bool
        \seq_map_inline:Nn \l__CQ_pic_layout_seq
          {
            \bool_if:NF \l__CQ_pic_firstrow_bool
              { \skip_vertical:n { \l__CQ_pic_vgap_dim } }
            \bool_set_false:N \l__CQ_pic_firstrow_bool
            \hbox_to_wd:nn { \l__CQ_pic_avail_dim }
              { \__CQ_pic_align_row:n {##1} }
          }
      }
    \par
    \noindent \box_use:N \l__CQ_pic_all_box
    \par
  }

% ---------- 引擎 ----------
% #1 = 图片数（1..8）  #2 = 键值  #3 = 各图片（文件名 / \includegraphics / 任意内容）
\cs_new_protected:Npn \__CQ_pictures:nnn #1 #2 #3
  {
    \begingroup
    \keys_set:nn { CQ_keys_pictures } {#2}
    \dim_set:Nn \l__CQ_pic_avail_dim { \linewidth }
    \clist_set:Nn \l__CQ_pic_files_clist {#3}
    \clist_set_eq:NN \l__CQ_pic_files_local_clist \l__CQ_pic_files_clist

    % ---- 逐图构建：尺寸 → 图片盒 → 整图盒（图 + 编号/标题行） ----
    \int_step_inline:nn {#1}
      {
        \clist_pop:NN \l__CQ_pic_files_local_clist \l__CQ_pic_item_tl
        \tl_set:Nx \l__CQ_pic_letter_tl { \int_to_Alph:n {##1} }
        \__CQ_pic_prepare_item:NV \l__CQ_pic_item_tl \l__CQ_pic_letter_tl
        \hbox_set:cn { l__CQ_pic_img_##1_box } { \tl_use:N \l__CQ_pic_item_tl }
        \dim_set:cn { l__CQ_pic_wd_##1_dim }
          { \box_wd:c { l__CQ_pic_img_##1_box } }
        \vbox_set:cn { l__CQ_pic_box_##1_box }
          {
            \offinterlineskip
            \box_use:c { l__CQ_pic_img_##1_box }
            \bool_if:NT \l__CQ_pic_showlabel_bool
              {
                \skip_vertical:n { 2pt }
                \hbox_to_wd:nn { \dim_use:c { l__CQ_pic_wd_##1_dim } }
                  {
                    \hss \small
                    图 \__CQ_pic_num:n {##1}
                    \tl_if_empty:cF { l__CQ_pic_cap_ \l__CQ_pic_letter_tl _tl }
                      { \quad
                        \tl_use:c { l__CQ_pic_cap_ \l__CQ_pic_letter_tl _tl } }
                    \hss
                  }
              }
          }
      }

    % ---- 发出 \label（在盒子外，showlabel=false 时引用依然有效） ----
    \int_step_inline:nn {#1}
      {
        \tl_set:Nx \l__CQ_pic_letter_tl { \int_to_Alph:n {##1} }
        \tl_if_empty:cF { l__CQ_pic_lab_ \l__CQ_pic_letter_tl _tl }
          {
            \tl_set:Nx \l__CQ_pic_labelname_tl
              { \tl_use:c { l__CQ_pic_lab_ \l__CQ_pic_letter_tl _tl } }
            \tl_set:Nx \@currentlabel { \__CQ_pic_num:n {##1} }
            \exp_args:NV \label \l__CQ_pic_labelname_tl
          }
      }

    % ---- 决定布局并排版 ----
    \__CQ_pic_decide:n {#1}
    \__CQ_pic_typeset:
    \endgroup
  }

% ---------- 用户命令 \onepicture .. \eightpicture ----------
\NewDocumentCommand \onepicture { O{} m }
  { \__CQ_pictures:nnn { 1 } {#1} { {#2} } }

\NewDocumentCommand \twopicture { O{} m m }
  { \__CQ_pictures:nnn { 2 } {#1} { {#2} , {#3} } }

\NewDocumentCommand \threepicture { O{} m m m }
  { \__CQ_pictures:nnn { 3 } {#1} { {#2} , {#3} , {#4} } }

\NewDocumentCommand \fourpicture { O{} m m m m }
  { \__CQ_pictures:nnn { 4 } {#1} { {#2} , {#3} , {#4} , {#5} } }

\NewDocumentCommand \fivepicture { O{} m m m m m }
  { \__CQ_pictures:nnn { 5 } {#1}
    { {#2} , {#3} , {#4} , {#5} , {#6} } }

\NewDocumentCommand \sixpicture { O{} m m m m m m }
  { \__CQ_pictures:nnn { 6 } {#1}
    { {#2} , {#3} , {#4} , {#5} , {#6} , {#7} } }

\NewDocumentCommand \sevenpicture { O{} m m m m m m m }
  { \__CQ_pictures:nnn { 7 } {#1}
    { {#2} , {#3} , {#4} , {#5} , {#6} , {#7} , {#8} } }

\NewDocumentCommand \eightpicture { O{} m m m m m m m m }
  { \__CQ_pictures:nnn { 8 } {#1}
    { {#2} , {#3} , {#4} , {#5} , {#6} , {#7} , {#8} , {#9} } }

