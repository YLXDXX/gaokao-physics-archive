% =================================================================
%  多图命令 \onepicture .. \eightpicture
%
%  可选键：
%    h/height, w/width          全体图片统一高/宽
%    hA..hH, wA..wH             单张图片高/宽（优先于全体）
%    keepaspectratio            默认 true（仅对 \includegraphics 生效）
%    capA..capH / captionA..    标题文字（显示为 "图a 标题"）
%    labelA..labelH             引用标记（\figref / \ref）
%    numstyle = letter|chinese  编号 a,b,c… 或 甲,乙,丙…
%    align = center|left|right  每行的对齐方式（默认 center）
%    showlabel = true|false     是否显示图片下方的编号/标题行
%    gap, vgap                  同行图片水平间距 / 行间距
%  自动排布：按每张图实际宽度分行；三图有专用算法
% =================================================================

% ---------- numstyle 处理（须在键定义之前定义：.initial:n 会立即执行代码） ----------
\cs_new_protected:Npn \__CQ_pic_set_numstyle:n #1
  {
