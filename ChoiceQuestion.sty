{
 \tl_if_blank:nTF {#1}
    {
        % 未指定宽度时，计算答案对应的长度，如果这个长度小于0.8cm，即将其设定为0.8cm，大于0.8cm就不管
        % 1) 在当前字体下量出答案的自然宽度
        \hbox_set:Nn \l_tmpa_box { #2 }
        % 2) 与 0.8cm 兜底比较，取较大者（0.8cm 即最短空线长度，可改）
        \dim_compare:nNnTF
            { \box_wd:N \l_tmpa_box }
            { > }
            { 0.8cm }
            { \CJKunderline[hidden=true,skip=false,format=\color{AnswerGreen},thickness=1pt]{#2} }
            { \CJKunderline[hidden=true,skip=false,format=\color{AnswerGreen},thickness=1pt]{ \makebox[0.8cm][c]{#2} } }
    }
    {
        \CJKunderline[hidden=true,skip=false,format=\color{AnswerGreen},thickness=1pt]{ \makebox[#1][c]{} }
    }
}
%   #1 = 可选宽度；为空表示与答案自然宽度一致（保持原行为）
%   #2 = 答案内容
