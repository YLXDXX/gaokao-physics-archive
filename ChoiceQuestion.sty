%选择题：四选项
\NewDocumentCommand \fourchoices{ O{}mmmm }
{
    \begingroup % to make sure the keys don't act globally

    \keys_set:nn{CQ_keys_choices}{#1}

    \bool_if:NTF{\l_CQ_choices_ispicture_bool}
    { \tl_set:Nn \l_CQ_choices_label_pos_tl {bottom} }
    { \tl_set:Nn \l_CQ_choices_label_pos_tl {top-left} }

    \tl_set:Nn \l_CQ_choices_A_tl {#2}
    \tl_set:Nn \l_CQ_choices_B_tl {#3}
    \tl_set:Nn \l_CQ_choices_C_tl {#4}
    \tl_set:Nn \l_CQ_choices_D_tl {#5}

    \bool_if:NT{\l_CQ_isanswershown_bool}{
        \seq_set_split:NnV \l_CQ_choices_answer_seq {} { \l_CQ_choices_answer_tl } %参数为空逐字分割

        \seq_map_inline:Nn \l_CQ_choices_answer_seq {
            \bool_if:NTF{\l_CQ_choices_ispicture_bool}
            {
                \str_if_eq:nnT{##1}{A}
                {
                    \tl_set:Nn \l_CQ_choices_A_tl { \fcolorbox{\l_CQ_answer_color_tl}{\l_CQ_answer_color_tl!10}{#2} }
                }
                \str_if_eq:nnT{##1}{B}
                {
                    \tl_set:Nn \l_CQ_choices_B_tl { \fcolorbox{\l_CQ_answer_color_tl}{\l_CQ_answer_color_tl!10}{#3} }
                }
                \str_if_eq:nnT{##1}{C}
                {
                    \tl_set:Nn \l_CQ_choices_C_tl { \fcolorbox{\l_CQ_answer_color_tl}{\l_CQ_answer_color_tl!10}{#4} }
                }
                \str_if_eq:nnT{##1}{D}
                {
                    \tl_set:Nn \l_CQ_choices_D_tl { \fcolorbox{\l_CQ_answer_color_tl}{\l_CQ_answer_color_tl!10}{#5} }
                }
            }
            {
                \str_if_eq:nnT{##1}{A}
                {
                    \tl_put_left:Nn \l_CQ_choices_A_tl {\color{\l_CQ_answer_color_tl}}
                }
                \str_if_eq:nnT{##1}{B}
                {
                    \tl_put_left:Nn \l_CQ_choices_B_tl {\color{\l_CQ_answer_color_tl}}
                }
                \str_if_eq:nnT{##1}{C}
                {
                    \tl_put_left:Nn \l_CQ_choices_C_tl {\color{\l_CQ_answer_color_tl}}
                }
                \str_if_eq:nnT{##1}{D}
                {
                    \tl_put_left:Nn \l_CQ_choices_D_tl {\color{\l_CQ_answer_color_tl}}
                }
            }
        }
    }
    \use:e{\exp_not:N\begin{choices}[label-pos=\l_CQ_choices_label_pos_tl,top-sep=3pt,
        linesep={0.5ex~plus~0.5ex~minus~0.2ex},label={\exp_not:N\color{TextDark}\exp_not:N\Alph*.}
    ]}
        \item \color{TextDark}\l_CQ_choices_A_tl
        \item \color{TextDark}\l_CQ_choices_B_tl
        \item \color{TextDark}\l_CQ_choices_C_tl
        \item \color{TextDark}\l_CQ_choices_D_tl
    \end{choices}
    \endgroup
}

