    numstyle .initial:n = letter ,
    align .code:n = { \__CQ_pic_set_align:n {#1} } ,
    align .initial:n = center ,
    showlabel .bool_set:N = \l__CQ_pic_showlabel_bool ,
    showlabel .initial:n  = true ,
    showlabel .default:n  = true ,
    % 单图（\onepicture）的简写
    cap   .code:n = { \tl_set:cn { l__CQ_pic_cap_A_tl } {#1} } ,
    label .code:n = { \tl_set:cn { l__CQ_pic_lab_A_tl } {#1} } ,
    unknown .code:n = \msg_error:nn { CQ_keys_pictures } { unknown-key },
  }
\__CQ_pic_define_size_keys:n { CQ_keys_pictures }

% 每张图的标题 / 引用键（capA、captionA、labelA …）
