      {
        { letter  } { \tl_set:Nn \l__CQ_pic_numstyle_tl { letter } }
        { chinese } { \tl_set:Nn \l__CQ_pic_numstyle_tl { chinese } }
      }
      { \msg_error:nnn { CQ_keys_pictures } { bad-numstyle } {#1} }
  }

% ---------- align 处理（同样须在键定义之前定义） ----------
\cs_new_protected:Npn \__CQ_pic_set_align:n #1
  {
    \str_case:nnF {#1}
      {
        { center } { \tl_set:Nn \l__CQ_pic_align_tl { center } }
        { left   } { \tl_set:Nn \l__CQ_pic_align_tl { left   } }
        { right  } { \tl_set:Nn \l__CQ_pic_align_tl { right  } }
      }
      { \msg_error:nnn { CQ_keys_pictures } { bad-align } {#1} }
  }

% ---------- 键 ----------
\keys_define:nn { CQ_keys_pictures }
  {
    gap  .dim_set:N = \l__CQ_pic_gap_dim ,
    gap  .initial:n = 1em ,
    vgap .dim_set:N = \l__CQ_pic_vgap_dim ,
    vgap .initial:n = 0.5em ,
